# ─────────────────────────────────────────────────────────────────────────────
# Trek Management System — Environment Variables
# Copy to .env and fill in values. Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

APP_ENV=dev   # dev | prod

# ── Database (Supabase PostgreSQL) ────────────────────────────────────────────
DB_URL=jdbc:postgresql://<host>:<port>/<database>?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=<your-db-password>

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 64
JWT_SECRET=<base64-encoded-256bit-secret>

# ── CORS (comma-separated, no trailing slash) ─────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com

# ── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=<razorpay-secret>
RAZORPAY_WEBHOOK_SECRET=<webhook-secret>

# ── Supabase Storage ──────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-jwt>

# ── SMTP ─────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your@email.com
SMTP_PASSWORD=<app-password>
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME=Trek Management System

# ── App ───────────────────────────────────────────────────────────────────────
APP_BASE_URL=https://yourdomain.com
PORT=8080
